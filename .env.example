# BCHN / Bitcoin Cash solo pool
NETWORK=mainnet
RPC_URL=http://YOUR_BCHN_HOST:8332
RPC_USER=change_me
RPC_PASSWORD=change_me
ZMQ_HASHBLOCK=tcp://YOUR_BCHN_HOST:28332

STRATUM_HOST=0.0.0.0
STRATUM_PORT=41837
API_HOST=0.0.0.0

DB_PATH=/data/pool.sqlite
COINBASE_TAG=/WxBCH-Pool/
COINBASE_EXTRA_HEX=
INITIAL_DIFFICULTY=8192
MIN_DIFFICULTY=0.00001
MAX_DIFFICULTY=1000000000000
TARGET_SHARE_SECONDS=30
VARDIFF_MIN_INTERVAL_SECONDS=60
JOB_REFRESH_SECONDS=10
EXTRANONCE1_SIZE=4
EXTRANONCE2_SIZE=4
VERSION_ROLLING_MASK=1fffe000

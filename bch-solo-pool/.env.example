# Local Docker development only.
# Umbrel users can configure these values from the first-run web setup page.
BCH_RPC_URL=http://host.docker.internal:8332/
BCH_RPC_USER=poolrpc
BCH_RPC_PASSWORD=
BCH_ZMQ_URL=tcp://host.docker.internal:28332
BCH_PAYOUT_ADDRESS=
POOL_ID=BCH Solo Pool
STRATUM_HOST=0.0.0.0
STRATUM_PORT=3334
WEB_HOST=0.0.0.0
WEB_PORT=8080
START_DIFFICULTY=1000
VARDIFF_ENABLED=true
VARDIFF_TARGET_SECONDS=30
VARDIFF_MIN=0.001
VARDIFF_MAX=65536
COINBASE_MESSAGE=BCH Solo Pool
DB_PATH=/data/pool.sqlite3
CONFIG_PATH=/data/config.json
LOG_LEVEL=INFO
